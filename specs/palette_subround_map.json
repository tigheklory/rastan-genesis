{
  "schema_version": "rastan-palette-subround-map/v1",
  "registry_id": "palette_subround_map",
  "authority": "Andy (RG-022). Companion index to specs/palette_decisions.json (the sole palette-decision registry). This file does NOT store color decisions; it enumerates the authentic subround/environment palette KEYS and native-graphics availability. All color/line decisions live in palette_decisions.json keyed by `scene_key`.",
  "doc": [
    "Stable palette key scheme (RG-022 section 2). genesistan_current_scene_id alone is insufficient:",
    "R1-S1/R1-S2/R2-S1 all report scene_id=1. The authentic key combines round + subround + the",
    "segment/record band (a5@0x13E) + residency/epoch + graphics family. Subround is derived from the",
    "arcade stage index a5@0x1242 = (round-1)*23 + 16*castle + 22*boss (RG-019). Line 2 is the arcade-",
    "controlled Plane-B line (reserved); Plane-B is NOT user-authored."
  ],
  "key_format": "PAL-R{round}-S{subround}-{family}-{env}  e.g. PAL-R1-S2-PLANEA-CASTLE-01, PAL-R1-S1-PC090OJ-RASTAN",
  "families": {
    "PLANEA": {"subsystem": "PC080SN Plane A background", "authorable": true, "genesis_lines": [0, 1, 3],
               "note": "offline-authored; consumed at scene entry (display-off). Line 2 excluded."},
    "PLANEB": {"subsystem": "PC080SN Plane B background", "authorable": false, "genesis_lines": [2],
               "note": "Line 2 is reserved/arcade-controlled (RESERVED_LINES). Shown read-only; never authored."},
    "PC090OJ": {"subsystem": "PC090OJ sprites (player/enemies/items)", "authorable": true, "genesis_lines": [0, 1, 3],
                "note": "sprite families are broadly converted across rounds; palette per scene still per-round."}
  },
  "native_status_vocabulary": {
    "source_available": "arcade source graphics/palette data exist (always true in-ROM).",
    "native_converted": "Cody native Plane A/B package exists for this subround (RG-021/0499).",
    "native_not_converted": "no native Plane A/B package yet.",
    "mode_a": "scene recognized (scene_id=1) but PC080SN content absent -> blank layers.",
    "mode_b": "scene NOT recognized (scene_id=0, source outside genesistan_scene_a0_ranges) -> blank screen.",
    "palette_missing": "no palette decision authored for this scene_key.",
    "palette_provisional": "a provisional palette decision exists (e.g. raw arcade conversion); awaiting Tighe approval.",
    "palette_approved": "Tighe-approved decision exists in palette_decisions.json."
  },
  "subround_offsets_in_round": {"1_outside": 0, "2_castle": 16, "3_boss": 22},
  "records_per_round": 23,
